# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Data cache（DuckDB + 股票/板块 json 快照，均为本地产物）
data/cache/

# HuggingFace 模型权重缓存（Kronos，挂卷到容器 /root/.cache/huggingface）
data/hf_cache/

# 第三方 Kronos 仓库 clone（自带 .git，误 add 会变成嵌套仓库）
tests/kronos_repo/

# AI 生成策略的中间产物（待校验 / 校验失败归档），纯本地垃圾；
# 已启用的 strategy/custom/*.py 是正经产物，照常入 git
strategy/custom/_staging/*
!strategy/custom/_staging/.gitkeep
strategy/custom/_rejected/*
!strategy/custom/_rejected/.gitkeep

# Environment & secrets
.env
.env.local

# Local deploy config (machine-specific resource limits etc.)
docker-compose.yml

# Local stock pool (user-specific watchlist)
config/stocks.json

# Claude Code：本机个人配置（settings.local.json 里是免确认权限之类的本地偏好）不入 git，
# 但项目级共享配置（hooks/自定义 agent/自定义 slash command/项目技能）照常提交。
# 必须写 .claude/* 而不是 .claude/——整目录被忽略时 git 不会进目录，下面的 ! 例外会全部失效。
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/commands/
!.claude/skills/

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
